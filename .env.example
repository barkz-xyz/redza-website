# Redza website only. Set these in Vercel's Production scope, then rebuild.
# VERCEL_ENV is provided by Vercel; do not manually set it in local or preview.
SITE_URL=https://redzaweb-codex.vercel.app
# Umami Cloud Hobby: public Website ID. Leave blank to disable analytics.
NEXT_PUBLIC_UMAMI_WEBSITE_ID=
# Cloud does not use Neon, database credentials, APP_SECRET or an API key.
